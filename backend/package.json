{
  "name": "rvin-engine-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.js",
    "start": "tsx src/server.js",
    "db:generate": "dotenv -e .env -- prisma generate",
    "db:push": "dotenv -e .env -- prisma db push && dotenv -e .env -- prisma generate",
    "db:migrate": "dotenv -e .env -- prisma migrate dev && dotenv -e .env -- prisma generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.14.0"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prisma": "^7.0.0",
    "tsx": "^4.19.3"
  }
}
